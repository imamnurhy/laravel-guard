# ==============================================================================
# AppGuard Configuration Environment Variables
# Salin variabel ini ke file .env pada proyek Laravel Anda
# ==============================================================================

# Mode kerja guard:
# - 'monitor' : Hanya mencatat insiden ke log (aman untuk profiling awal tanpa memblokir)
# - 'enforce' : Aktif menolak request (HTTP 403 / 429) dan auto-banned user
GUARD_ENABLED=true
GUARD_MODE=enforce

# Cache driver untuk counter reputasi (disarankan 'redis' pada produksi)
GUARD_CACHE_STORE=redis

# Log channel khusus (opsional, null = channel default Laravel)
GUARD_LOG_CHANNEL=null

# Ambang batas skor penalti IP
GUARD_THROTTLE_THRESHOLD=50
GUARD_BLOCK_THRESHOLD=100
GUARD_REPUTATION_TTL=1800

# Fitur Auto-Banned Pengguna
GUARD_USER_BAN_ENABLED=true
GUARD_USER_BAN_THRESHOLD=100
GUARD_USER_MODEL=App\Models\User

# Notifikasi darurat Telegram via package explorin/tebot
GUARD_TEBOT_ENABLED=true

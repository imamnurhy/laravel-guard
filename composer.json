{
    "name": "explorin/laravel-guard",
    "description": "Application-level security guard: scoring-based detection of brute force, enumeration and probing before requests reach your controllers.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/auth": "^10.0|^11.0|^12.0",
        "illuminate/routing": "^10.0|^11.0|^12.0",
        "illuminate/events": "^10.0|^11.0|^12.0",
        "psr/log": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": { "AppGuard\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "AppGuard\\Tests\\": "tests/" }
    },
    "extra": {
        "laravel": {
            "providers": [ "AppGuard\\GuardServiceProvider" ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
